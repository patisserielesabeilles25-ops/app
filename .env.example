# ---------------------------------------------------------------------------
# Nahla Cake Panel — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key — operates ONLY under Row Level Security (safe to expose)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role / secret key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
# Do not commit a real value. Rotate immediately if it is ever leaked.
SUPABASE_SECRET_KEY=
